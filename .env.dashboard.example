# The dashboard. Copy to .env.dashboard.
#
#   make deploy-dashboard
#
# No secrets, and no .env.shared: the dashboard is a static bundle served by
# nginx. It holds no database credentials and no encryption key, and it should
# never be given either.
#
# VITE_API_BASE_URL is baked into the JavaScript at BUILD time -- Vite inlines
# VITE_* variables. Changing it requires a rebuild; restarting does nothing.
# Whatever origin the dashboard is served from must also appear in the API's
# PAYMUX_CORS_ORIGINS.

VITE_API_BASE_URL=https://api.example.com

# Published host port. Ignored when a platform proxies to the container
# directly; bind the domain to container port 80 in that case.
PAYMUX_DASHBOARD_PORT=5173
