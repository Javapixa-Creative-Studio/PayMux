# The worker, on top of .env.shared. Copy to .env.worker.
#
#   make deploy-worker
#
# DATABASE_URL and PAYMUX_ENCRYPTION_KEY are in .env.shared and must be the
# same values the API uses. See that file for why.
#
# The worker has no API and publishes no port. It serves unauthenticated
# Prometheus metrics on container port 9090: give it no domain.

PAYMUX_WORKER_CONCURRENCY=20
PAYMUX_WORKER_POLL_INTERVAL=
PAYMUX_WEBHOOK_TIMEOUT=

# Leave false in production. Setting it true lets applications register
# webhook destinations on private and link-local addresses, which removes the
# SSRF protection on outbound dispatch.
PAYMUX_ALLOW_PRIVATE_WEBHOOK_DESTINATIONS=false
