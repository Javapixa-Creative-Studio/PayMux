# The API, on top of .env.shared. Copy to .env.api.
#
#   make deploy-api
#
# Everything the worker also needs -- DATABASE_URL, PAYMUX_ENCRYPTION_KEY, the
# pool settings -- lives in .env.shared, not here.

# The API's own public URL, used to build callback URLs handed to gateways.
PAYMUX_BASE_URL=https://api.example.com

# Published host port. Ignored when a platform proxies to the container
# directly; bind the domain to container port 8080 in that case.
PAYMUX_API_PORT=8080

# ---------------------------------------------------------------------------
# First administrator
#
# Seeded on startup only when no administrator exists yet. Remove both once
# the account has been created.
# ---------------------------------------------------------------------------
PAYMUX_ADMIN_EMAIL=
PAYMUX_ADMIN_PASSWORD=
PAYMUX_ADMIN_SESSION_TTL=

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# The dashboard's origin, explicitly. A wildcard is ignored: admin responses
# carry credentials, and reflecting an arbitrary origin alongside them would
# let any site drive the API with an operator's session. This must match where
# the dashboard is actually served from, or it will load and then fail every
# request.
PAYMUX_CORS_ORIGINS=https://dashboard.example.com

# Turn this ON when a reverse proxy fronts the API and overwrites
# X-Forwarded-For, which is the normal case on Easypanel, Coolify and Dokploy.
# Left off behind a proxy, every request appears to come from the proxy:
# per-key rate limits collapse into one bucket and the audit trail records the
# proxy instead of the caller. Leave it OFF if the API is directly exposed.
PAYMUX_TRUST_PROXY_HEADERS=true

PAYMUX_RATE_LIMIT_PER_SECOND=
PAYMUX_RATE_LIMIT_BURST=
PAYMUX_MAX_REQUEST_BODY_BYTES=
