# The landing page. Copy to .env.landing.
#
#   make deploy-landing
#
# One variable, and no secrets of any kind. The landing page is a single
# static HTML file: no database, no API, no encryption key. It is the most
# publicly exposed service here and the one with the least to lose, and this
# file exists to keep it that way.

# Published host port. Ignored when a platform proxies to the container
# directly; bind the domain to container port 80 in that case.
PAYMUX_LANDING_PORT=7881
