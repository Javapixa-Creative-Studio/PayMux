# ---------------------------------------------------------------------------
# PayMux configuration
#
# Copy to .env and fill in. Every value below is read by both the API and the
# worker unless noted otherwise.
# ---------------------------------------------------------------------------

# development | staging | production
PAYMUX_ENV=development

PAYMUX_HTTP_ADDR=:8080
PAYMUX_BASE_URL=http://localhost:8080

# debug | info | warn | error
PAYMUX_LOG_LEVEL=info
# Defaults to true in production, false elsewhere.
# PAYMUX_LOG_JSON=false

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

DATABASE_URL=postgres://paymux:paymux@localhost:5432/paymux?sslmode=disable
PAYMUX_DB_MAX_CONNS=20
PAYMUX_DB_MIN_CONNS=2

# Used by docker compose to provision the bundled PostgreSQL service.
POSTGRES_USER=paymux
POSTGRES_PASSWORD=paymux
POSTGRES_DB=paymux
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Encryption
#
# 32 bytes, hex or base64. Gateway server keys and webhook secrets are sealed
# with this key, so losing it makes existing gateway credentials unreadable and
# rotating it requires re-entering them.
#
#   openssl rand -hex 32
# ---------------------------------------------------------------------------

PAYMUX_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# First administrator
#
# Seeded on startup only when no administrator exists yet. Remove both values
# once the account has been created.
# ---------------------------------------------------------------------------

PAYMUX_ADMIN_EMAIL=
PAYMUX_ADMIN_PASSWORD=

# How long a dashboard session stays valid.
PAYMUX_ADMIN_SESSION_TTL=12h

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------

PAYMUX_WORKER_CONCURRENCY=20
PAYMUX_WORKER_POLL_INTERVAL=2s
PAYMUX_WEBHOOK_TIMEOUT=15s

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# Comma-separated origins allowed to call the admin API from a browser.
PAYMUX_CORS_ORIGINS=http://localhost:5173

# Leave false in production. Setting it to true lets applications register
# webhook destinations on private and link-local addresses, which removes
# PayMux's SSRF protection (PRD §73).
PAYMUX_ALLOW_PRIVATE_WEBHOOK_DESTINATIONS=false

PAYMUX_MAX_REQUEST_BODY_BYTES=1048576
PAYMUX_HTTP_CLIENT_TIMEOUT=30s
PAYMUX_METRICS_ENABLED=true

# ---------------------------------------------------------------------------
# Dashboard (build time)
# ---------------------------------------------------------------------------

VITE_API_BASE_URL=http://localhost:8080
PAYMUX_DASHBOARD_PORT=5173
PAYMUX_API_PORT=8080
