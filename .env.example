# ---------------------------------------------------------------------------
# PayMux configuration
#
# Copy to .env and fill in. Every value below is read by both the API and the
# worker unless noted otherwise.
#
# This file configures the whole stack from docker-compose.yml, on one host.
# Deploying services separately, one per compose file, uses a different set:
#
#   .env.shared.example      DATABASE_URL and PAYMUX_ENCRYPTION_KEY, shared by
#                            the API and worker, which must agree on both
#   .env.api.example         the API only
#   .env.worker.example      the worker only
#   .env.dashboard.example   the dashboard, which needs no secrets
#   .env.landing.example     the landing page, which needs one variable
#
# See `make help` for the deploy-* targets that pair them with the right
# compose file.
# ---------------------------------------------------------------------------

# development | staging | production
PAYMUX_ENV=development

# Ignored under docker compose, which pins the listener to :8080 because the
# published port mapping depends on it. Change PAYMUX_API_PORT instead.
PAYMUX_HTTP_ADDR=:8080
PAYMUX_BASE_URL=http://localhost:8080

# debug | info | warn | error
PAYMUX_LOG_LEVEL=info
# Defaults to true in production, false elsewhere.
# PAYMUX_LOG_JSON=false

# ---------------------------------------------------------------------------
# Database
#
# docker-compose.yml does not start a database. This is the connection string
# to the PostgreSQL you already run, and it is required.
#
# A managed instance almost always wants sslmode=require. sslmode=disable is
# only reasonable when the database is reachable on a private network you
# trust, which is the case for the bundled container below.
# ---------------------------------------------------------------------------

DATABASE_URL=postgres://paymux:paymux@localhost:5432/paymux?sslmode=disable
PAYMUX_DB_MAX_CONNS=20
PAYMUX_DB_MIN_CONNS=2
PAYMUX_DB_CONN_TIMEOUT=10s

# ---------------------------------------------------------------------------
# Bundled PostgreSQL, if you want compose to run one
#
# Only read when docker-compose.postgres.yml is layered on:
#
#   make up-postgres
#   docker compose -f docker-compose.yml -f docker-compose.postgres.yml up -d
#
# That file sets DATABASE_URL itself, so the value above is ignored while it is
# in use. Uncomment COMPOSE_FILE to make the pair the default for every plain
# `docker compose` command in this directory.
# ---------------------------------------------------------------------------

# COMPOSE_FILE=docker-compose.yml:docker-compose.postgres.yml
POSTGRES_USER=paymux
POSTGRES_PASSWORD=paymux
POSTGRES_DB=paymux
# Only takes effect if you uncomment the ports block in
# docker-compose.postgres.yml, which is commented out on purpose: the
# database is reachable on the compose network without publishing it.
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Encryption
#
# 32 bytes, hex or base64. Gateway server keys and webhook secrets are sealed
# with this key, so losing it makes existing gateway credentials unreadable and
# rotating it requires re-entering them.
#
#   openssl rand -hex 32
# ---------------------------------------------------------------------------

PAYMUX_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# First administrator
#
# Seeded on startup only when no administrator exists yet. Remove both values
# once the account has been created.
# ---------------------------------------------------------------------------

PAYMUX_ADMIN_EMAIL=
PAYMUX_ADMIN_PASSWORD=

# How long a dashboard session stays valid.
PAYMUX_ADMIN_SESSION_TTL=12h

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------

PAYMUX_WORKER_CONCURRENCY=20
PAYMUX_WORKER_POLL_INTERVAL=2s
PAYMUX_WEBHOOK_TIMEOUT=15s

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# Comma-separated origins allowed to call the admin API from a browser.
# A wildcard is ignored: admin responses carry credentials, and reflecting an
# arbitrary origin alongside them would let any website drive the API with an
# operator's session. Name the dashboard's origin explicitly.
PAYMUX_CORS_ORIGINS=http://localhost:5173

# Believe X-Forwarded-For. Turn this ON in production when PayMux sits behind
# a reverse proxy that overwrites the header, and OFF when PayMux is directly
# exposed. Left off behind a proxy, every request appears to come from the
# proxy: per-client rate limits collapse into one bucket and the audit trail
# records the proxy's address instead of the caller's.
PAYMUX_TRUST_PROXY_HEADERS=false

# How fast one API key may call the application API.
PAYMUX_RATE_LIMIT_PER_SECOND=50
PAYMUX_RATE_LIMIT_BURST=100

# Leave false in production. Setting it to true lets applications register
# webhook destinations on private and link-local addresses, which removes
# PayMux's SSRF protection (PRD §73).
PAYMUX_ALLOW_PRIVATE_WEBHOOK_DESTINATIONS=false

PAYMUX_MAX_REQUEST_BODY_BYTES=1048576
PAYMUX_HTTP_CLIENT_TIMEOUT=30s

# ---------------------------------------------------------------------------
# Metrics
#
# The API serves /metrics on its own listener. The worker has no API, so it
# serves /metrics on PAYMUX_METRICS_ADDR instead. Neither endpoint is
# authenticated: keep them off the public network.
# ---------------------------------------------------------------------------

PAYMUX_METRICS_ENABLED=true
# Ignored under docker compose, which pins the worker's metrics listener to
# :9090. It is not published, and it should not be given a domain.
PAYMUX_METRICS_ADDR=:9090

# ---------------------------------------------------------------------------
# Dashboard (build time)
# ---------------------------------------------------------------------------

VITE_API_BASE_URL=http://localhost:8080
PAYMUX_DASHBOARD_PORT=5173
PAYMUX_API_PORT=8080

# The marketing page, started only by `docker compose --profile landing up`.
PAYMUX_LANDING_PORT=7881
