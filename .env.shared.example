# Shared by the API and the worker. Nothing else reads this file.
#
# These two services are one system split across two processes: the API seals
# gateway secrets into the database, the worker reads them back out. Both
# values below must therefore be IDENTICAL in both deployments.
#
#   DATABASE_URL           different databases means the worker drains a queue
#                          nobody is filling
#   PAYMUX_ENCRYPTION_KEY  a different key means the worker cannot decrypt the
#                          gateway credentials the API wrote, and every
#                          dispatch fails at the point of use rather than at
#                          startup
#
# That is why they live in one file passed to both, rather than being copied
# into two. Copy this to .env.shared and fill it in.
#
#   make deploy-api      --env-file .env.shared --env-file .env.api
#   make deploy-worker   --env-file .env.shared --env-file .env.worker

# development | staging | production
PAYMUX_ENV=production

# debug | info | warn | error
PAYMUX_LOG_LEVEL=info
# Defaults to true in production, false elsewhere. Empty means unset.
PAYMUX_LOG_JSON=

# A managed instance almost always wants sslmode=require. sslmode=disable is
# only reasonable on a private network you trust.
DATABASE_URL=postgres://paymux:paymux@db.internal:5432/paymux?sslmode=require

# 32 bytes, hex or base64:  openssl rand -hex 32
#
# Losing this makes existing gateway credentials unreadable, and rotating it
# means re-entering every one of them.
PAYMUX_ENCRYPTION_KEY=

# Connection pool. Empty means unset, and the binary applies its own default.
PAYMUX_DB_MAX_CONNS=
PAYMUX_DB_MIN_CONNS=
PAYMUX_DB_CONN_TIMEOUT=

PAYMUX_HTTP_CLIENT_TIMEOUT=
PAYMUX_METRICS_ENABLED=
